# Salin ke fitness/.env dan isi.
NODE_ENV=production
PORT=3000
# URL awam laman anda (untuk return/callback ToyyibPay)
BASE_URL=https://laman-anda.com
# Rentetan rawak panjang. Jana: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PRICE_RM=49
# Jaminan pulang wang (hari). 0 = sembunyikan.
REFUND_DAYS=14
# Set 1 jika di belakang Nginx/Render/Railway
TRUST_PROXY=1

# ToyyibPay: sandbox dahulu, kemudian tukar ke https://toyyibpay.com
TOYYIBPAY_BASE=https://dev.toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Untuk cuba di komputer sendiri tanpa ToyyibPay (tak dibenarkan bila NODE_ENV=production)
# DEMO_MODE=1

# Akaun admin: e-mel yang boleh buka /admin (pisahkan dengan koma). Daftar akaun biasa dengan e-mel ini dahulu.
ADMIN_EMAILS=

# E-mel (lupa kata laluan + e-mel terima kasih selepas bayar) melalui https://resend.com
# Sahkan domain anda di Resend, kemudian isi:
RESEND_API_KEY=
MAIL_FROM=BentukBadan <hai@laman-anda.com>
