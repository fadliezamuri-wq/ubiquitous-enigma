{
  "name": "ubiquitous-enigma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\"",
    "fitness": "node --env-file-if-exists=fitness/.env fitness/server.mjs",
    "fitness:demo": "DEMO_MODE=1 node fitness/server.mjs",
    "test:fitness": "node --test \"fitness/test/*.test.mjs\"",
    "buku": "node fitness/buku/bina.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
